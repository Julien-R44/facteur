{
  "name": "@facteurjs/react",
  "version": "2.0.0-beta.2",
  "description": "React hooks and components for Facteur - Build notification centers in your React application",
  "keywords": [
    "hooks",
    "notification-center",
    "notification-client",
    "notifications",
    "react",
    "react-query",
    "tanstack-query"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.tsx",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "stub": "tsdown",
    "test": "tsx tests/index.ts",
    "typecheck": "tsc --noEmit",
    "quick:test": "tsx tests/index.ts"
  },
  "dependencies": {
    "@facteurjs/client": "workspace:*"
  },
  "devDependencies": {
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/react": "^19.2.13",
    "react": "^19.2.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
