{
  "name": "@facteurjs/hono",
  "version": "2.0.0",
  "description": "Hono integration for Facteur - Send notifications via multiple channels in your Hono application",
  "keywords": [
    "cloudflare-workers",
    "edge",
    "email",
    "hono",
    "honojs",
    "notification-system",
    "notifications",
    "push-notifications",
    "sms",
    "webhooks"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julien-R44/facteur.git",
    "directory": "packages/hono"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "stub": "tsdown",
    "test": "tsx tests/index.ts",
    "typecheck": "tsc --noEmit",
    "quick:test": "tsx tests/index.ts"
  },
  "dependencies": {
    "@facteurjs/core": "workspace:*"
  },
  "devDependencies": {
    "hono": "^4.13.13"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  }
}
