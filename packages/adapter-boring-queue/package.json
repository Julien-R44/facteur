{
  "name": "@facteurjs/adapter-boring-queue",
  "version": "2.0.0-beta.0",
  "description": "BoringNode Queue adapter for Facteur - Background job processing for notifications",
  "keywords": [
    "facteur",
    "notifications",
    "queue",
    "boringnode",
    "jobs",
    "background-jobs",
    "async"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "stub": "tsdown",
    "test": "tsx tests/index.ts",
    "typecheck": "tsc --noEmit",
    "quick:test": "tsx tests/index.ts"
  },
  "dependencies": {
    "@facteurjs/core": "workspace:*"
  },
  "devDependencies": {
    "@boringnode/queue": "^0.1.0"
  },
  "peerDependencies": {
    "@boringnode/queue": ">=0.1.0"
  }
}
