{
  "name": "@facteurjs/client",
  "version": "1.0.0-beta.4",
  "description": "JavaScript client for Facteur - Fetch and manage notifications from your frontend application",
  "keywords": [
    "frontend",
    "javascript",
    "notification-center",
    "notification-client",
    "notifications",
    "typescript"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "stub": "tsdown",
    "test": "tsx tests/index.ts",
    "typecheck": "tsc --noEmit",
    "quick:test": "tsx tests/index.ts"
  },
  "dependencies": {
    "ky": "^1.14.2"
  }
}
