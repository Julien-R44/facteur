{
  "name": "@facteurjs/adonisjs",
  "version": "1.0.0-beta.4",
  "description": "AdonisJS integration for Facteur - Send notifications via multiple channels in your AdonisJS application",
  "keywords": [
    "adonis",
    "adonisjs",
    "email",
    "notification-system",
    "notifications",
    "push-notifications",
    "sms",
    "webhooks"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./channels/aws-sns": "./src/channels/aws-sns.ts",
    "./channels/database": "./src/channels/database.ts",
    "./channels/discord": "./src/channels/discord.ts",
    "./channels/expo": "./src/channels/expo.ts",
    "./channels/fcm": "./src/channels/fcm.ts",
    "./channels/slack": "./src/channels/slack.ts",
    "./channels/socketio": "./src/channels/socketio.ts",
    "./channels/transmit": "./src/channels/transmit.ts",
    "./channels/twilio": "./src/channels/twilio.ts",
    "./channels/webhook": "./src/channels/webhook.ts",
    "./channels/webpush": "./src/channels/webpush.ts",
    "./database": "./src/database/index.ts",
    "./services/main": "./src/services/main.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json",
    "./facteur_provider": "./dist/providers/facteur_provider.js"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./channels/aws-sns": "./dist/channels/aws-sns.js",
      "./channels/database": "./dist/channels/database.js",
      "./channels/discord": "./dist/channels/discord.js",
      "./channels/expo": "./dist/channels/expo.js",
      "./channels/fcm": "./dist/channels/fcm.js",
      "./channels/slack": "./dist/channels/slack.js",
      "./channels/socketio": "./dist/channels/socketio.js",
      "./channels/transmit": "./dist/channels/transmit.js",
      "./channels/twilio": "./dist/channels/twilio.js",
      "./channels/webhook": "./dist/channels/webhook.js",
      "./channels/webpush": "./dist/channels/webpush.js",
      "./database": "./dist/database/index.js",
      "./services/main": "./dist/services/main.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json",
      "./facteur_provider": "./dist/providers/facteur_provider.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "stub": "tsdown",
    "test": "tsx tests/index.ts",
    "quick:test": "tsx tests/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@facteurjs/core": "workspace:*",
    "@julr/utils": "catalog:",
    "@poppinss/exception": "catalog:"
  },
  "devDependencies": {
    "@adonisjs/core": "^7.0.0-next.16",
    "@adonisjs/lucid": "^22.0.0-next.1",
    "@adonisjs/mail": "^10.0.0-next.1",
    "@adonisjs/redis": "^10.0.0-next.2",
    "@adonisjs/transmit": "^2.0.0-1"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0-next.16",
    "@adonisjs/lucid": "^22.0.0-next.1",
    "@adonisjs/mail": "^10.0.0-next.1",
    "@adonisjs/redis": "^10.0.0-next.2",
    "@adonisjs/transmit": "^2.0.0-1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/redis": {
      "optional": true
    },
    "@adonisjs/transmit": {
      "optional": true
    }
  }
}
