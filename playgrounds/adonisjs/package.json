{
  "name": "adonisjs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "quick:test": "node ace test",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.2",
    "@adonisjs/cache": "^1.3.0",
    "@adonisjs/core": "^6.19.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/inertia": "^4.0.0-next.0",
    "@adonisjs/lucid": "^21.8.0",
    "@adonisjs/mail": "^9.2.2",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/transmit": "^2.0.2",
    "@adonisjs/transmit-client": "^1.0.0",
    "@adonisjs/vite": "^5.0.0-next.0",
    "@facteurjs/adonisjs": "workspace:*",
    "@facteurjs/client": "workspace:*",
    "@inertiajs/react": "^2.0.17",
    "@tanstack/react-query": "^5.83.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vinejs/vine": "^3.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.2.0",
    "edge.js": "^6.3.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.525.0",
    "luxon": "^3.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.1.0",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.3.0",
    "@swc/core": "1.10.16",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.1.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "ts-node-maintained": "^10.9.5",
    "vite": "^7.0.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
