{
  "name": "@facteurjs/monorepo",
  "private": true,
  "description": "Framework-agnostic notification system for Node.js",
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run -r --parallel typecheck",
    "build": "pnpm run -r build",
    "format": "oxfmt",
    "lint": "oxlint",
    "stub": "pnpm -r --parallel run stub",
    "test": "FORCE_COLOR=1 pnpm -r --parallel run test",
    "checks": "pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^2.3.2",
    "@japa/runner": "^4.4.0",
    "@julr/tooling-configs": "^5.0.0",
    "@poppinss/utils": "^7.0.0-next.4",
    "@types/node": "^25.0.3",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "p-event": "^6.0.1",
    "tsdown": "^0.18.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ],
    "patchedDependencies": {
      "@adonisjs/transmit": "patches/@adonisjs__transmit.patch"
    }
  }
}
