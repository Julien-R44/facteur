{
  "name": "@facteurjs/monorepo",
  "private": true,
  "description": "Framework-agnostic notification system for Node.js",
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run -r --parallel typecheck",
    "build": "pnpm run -r build",
    "format": "oxfmt",
    "lint": "oxlint",
    "stub": "pnpm -r --parallel run stub",
    "test": "FORCE_COLOR=1 pnpm -r --parallel run test",
    "release": "pnpm run build && changeset publish",
    "checks": "pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.4.0",
    "@julr/tooling-configs": "^6.4.0",
    "@poppinss/utils": "^7.1.2",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
