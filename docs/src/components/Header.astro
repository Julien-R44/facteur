---
import Icon from './Icon.astro'
import Logo from './Logo.astro'

interface Props {
  /** Docs layout: full-width bar with the burger button for the sidebar. */
  withMenu?: boolean
}

const { withMenu = false } = Astro.props
const isDocs = Astro.url.pathname.startsWith('/docs')
---

<header class:list={['site-header', { floating: !withMenu }]}>
  <div class="site-header-inner">
    {
      withMenu && (
        <button class="header-icon-button menu-button" type="button" aria-label="Open navigation" data-menu-open>
          <Icon name="lucide:menu" size={18} />
        </button>
      )
    }

    <a class="brand" href="/" aria-label="Facteur home">
      <Logo size={24} />
      <span class="brand-name">Facteur</span>
    </a>

    <nav class="header-nav" aria-label="Main">
      <a href="/docs/introduction" aria-current={isDocs ? 'page' : undefined}>Docs</a>
      <a href="/#channels">Channels</a>
      <a href="https://github.com/Julien-R44/facteur">GitHub</a>
    </nav>

    <div class="header-actions">
      {
        withMenu && (
      <button class="search-trigger" type="button" data-search-open aria-label="Search documentation">
        <Icon name="lucide:search" size={15} />
        <span>Search docs</span>
      </button>
        )
      }

      {
        !withMenu && (
          <a class="button button-primary header-cta" href="/docs/quick-start">
            Get started
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-height);
    border-bottom: 1px solid var(--border);
    background: rgb(12 12 13 / 0.78);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: var(--docs-width);
    height: 100%;
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* Landing: a floating pill */

  .site-header.floating {
    top: 14px;
    height: auto;
    margin-top: 14px;
    padding-inline: 16px;
    border: 0;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .floating .site-header-inner {
    gap: 20px;
    max-width: 880px;
    height: 56px;
    margin-inline: auto;
    padding: 0 8px 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: rgb(22 22 25 / 0.72);
    box-shadow:
      var(--glass-highlight),
      0 12px 32px -12px rgb(0 0 0 / 0.7);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .header-nav {
    display: flex;
    gap: 2px;
  }

  .floating .header-nav {
    margin-inline: auto;
  }

  .header-nav a {
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .header-nav a[aria-current='page'] {
    border-color: var(--border-strong);
    background: rgb(255 255 255 / 0.06);
    color: var(--text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .floating .header-actions {
    margin-left: 0;
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 240px;
    height: 36px;
    padding: 0 6px 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: rgb(255 255 255 / 0.03);
    color: var(--text-faint);
    font-size: 14px;
    transition: border-color 160ms ease;
  }

  .search-trigger span {
    flex: 1;
    text-align: left;
  }

  .header-cta {
    height: 36px;
    padding: 0 14px;
  }

  .header-icon-button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    color: var(--text-muted);
  }

  .menu-button {
    display: none;
    margin-left: -8px;
  }

  @media (hover: hover) and (pointer: fine) {
    .header-nav a:not([aria-current='page']):hover {
      background: rgb(255 255 255 / 0.05);
      color: var(--text);
    }

    .search-trigger:hover {
      border-color: var(--border-strong);
    }
  }

  @media (max-width: 1020px) {
    .menu-button {
      display: grid;
    }
  }

  @media (max-width: 900px) {
    .site-header:not(.floating) .header-nav {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .floating .header-nav {
      display: none;
    }

    .floating .header-actions {
      margin-left: auto;
    }
  }

  @media (max-width: 640px) {
    .site-header-inner {
      gap: 12px;
      padding-inline: 16px;
    }

    .search-trigger {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .search-trigger span {
      display: none;
    }
  }
</style>
