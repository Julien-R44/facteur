@component('layouts/main', { file })
  @let(siteConfig = await getConfig())
  @let(providers = await getProviders())

  <div class="landing">
    <a class="landing-skip" href="#main">Skip to content</a>
    <header class="landing-header landing-container">
      <a class="landing-brand" href="/" aria-label="Facteur home">
        @include('partials/logo')
        <span>facteur<span class="landing-brand-dot">.</span></span>
      </a>
      <nav class="landing-nav" aria-label="Main navigation">
        <a href="/docs/introduction">Documentation</a>
        <a class="landing-github" href="{{ siteConfig.links.github.href }}" aria-label="GitHub">
          @svg('tabler:brand-github', { width: 18, height: 18, 'aria-hidden': 'true' })
          <span>GitHub</span>
        </a>
        <button
          class="landing-theme"
          type="button"
          @click="$store.darkMode.toggle()"
          :aria-label="$store.darkMode.enabled ? 'Switch to light theme' : 'Switch to dark theme'"
          aria-label="Toggle color theme"
        >
          <span class="landing-sun">
            @svg('tabler:sun', { width: 20, height: 20, 'aria-hidden': 'true' })
          </span>
          <span class="landing-moon">
            @svg('tabler:moon', { width: 20, height: 20, 'aria-hidden': 'true' })
          </span>
        </button>
      </nav>
    </header>

    <main id="main">
      <section class="landing-hero landing-container" aria-labelledby="hero-title">
        <div class="landing-hero-copy">
          <div class="landing-eyebrow"><span class="landing-status-dot"></span> Your app’s delivery service</div>
          <h1 id="hero-title">One notification.<br>Every <span>destination.</span></h1>
          <p class="landing-lead">Notifications, without the tangled code. Define once, deliver across channels. A TypeScript-first library for Node.js, built to fit your stack.</p>
          <div class="landing-actions">
            <a class="landing-button" href="/docs/quick-start">
              Start building
              @svg('tabler:arrow-right', { width: 19, height: 19, 'aria-hidden': 'true' })
            </a>
            <a class="landing-text-link" href="/docs/introduction">
              Explore the docs
              @svg('tabler:arrow-up-right', { width: 17, height: 17, 'aria-hidden': 'true' })
            </a>
          </div>
          <div class="landing-install" x-data="{ status: '' }">
            <span aria-hidden="true">$</span>
            <code>npm install @facteurjs/core</code>
            <button
              type="button"
              aria-label="Copy installation command"
              @click="navigator.clipboard.writeText('npm install @facteurjs/core').then(() => { status = 'Copied!'; setTimeout(() => status = '', 2000) }).catch(() => { status = 'Select the command to copy' })"
            >
              @svg('tabler:copy', { width: 17, height: 17, 'aria-hidden': 'true' })
            </button>
            <span class="landing-copy-status" role="status" x-text="status"></span>
          </div>
          <p class="landing-fine-print">Open source. MIT licensed.</p>
        </div>

        <figure class="landing-dispatch">
          <div class="landing-dispatch-label" aria-hidden="true">01 / MESSAGE DISPATCH</div>
          <div class="landing-dispatch-map" aria-hidden="true">
            <svg class="landing-routes" viewBox="0 0 500 380" fill="none">
              <path d="M250 160V94Q250 66 222 66H133M250 160V94Q250 66 278 66H367M250 224V290Q250 318 222 318H133M250 224V290Q250 318 278 318H367" />
              <circle cx="133" cy="66" r="4" /><circle cx="367" cy="66" r="4" />
              <circle cx="133" cy="318" r="4" /><circle cx="367" cy="318" r="4" />
            </svg>
            <div class="landing-destination landing-destination-slack">
              @svg('tabler:brand-slack', { width: 23, height: 23 })
              <div><strong>Slack</strong><span>Hello, team.</span></div>
              <span class="landing-delivery-dot"></span>
            </div>
            <div class="landing-destination landing-destination-push">
              @svg('tabler:bell', { width: 23, height: 23 })
              <div><strong>Push</strong><span>Hello, anywhere.</span></div>
              <span class="landing-delivery-dot"></span>
            </div>
            <div class="landing-stamp">
              <div class="landing-stamp-inner">
                <span>FACTEUR</span>
                @include('partials/logo')
                <span>SPECIAL DELIVERY</span>
              </div>
            </div>
            <div class="landing-destination landing-destination-sms">
              @svg('tabler:message', { width: 23, height: 23 })
              <div><strong>SMS</strong><span>Hello, phone.</span></div>
              <span class="landing-delivery-dot"></span>
            </div>
            <div class="landing-destination landing-destination-app">
              @svg('tabler:inbox', { width: 23, height: 23 })
              <div><strong>In-app</strong><span>Hello, user.</span></div>
              <span class="landing-delivery-dot"></span>
            </div>
          </div>
          <figcaption><span>One API. Multiple channels.</span><span>DELIVERED WITH CARE ↗</span></figcaption>
        </figure>
      </section>

      <section class="landing-channel-strip" aria-label="Supported delivery channels">
        <div class="landing-container">
          <span class="landing-eyebrow">A few places we deliver</span>
          <div class="landing-channel-list">
            @each(channel in [
              { name: 'Slack', icon: 'tabler:brand-slack', href: '/docs/slack' },
              { name: 'Discord', icon: 'tabler:brand-discord', href: '/docs/discord' },
              { name: 'Twilio', icon: 'tabler:phone', href: '/docs/twilio' },
              { name: 'Firebase', icon: 'tabler:brand-firebase', href: '/docs/fcm' },
              { name: 'Expo', icon: 'tabler:device-mobile', href: '/docs/expo-notifications' },
              { name: 'AdonisJS Mail', icon: 'tabler:mail', href: '/docs/mail' },
              { name: 'Socket.IO', icon: 'tabler:brand-socket-io', href: '/docs/socketio' }
            ])
              <a href="{{ channel.href }}">
                @svg(channel.icon, { width: 20, height: 20, 'aria-hidden': 'true' })
                {{ channel.name }}
              </a>
            @end
            <a class="landing-more-link" href="#channels">
              All channels
              @svg('tabler:arrow-right', { width: 16, height: 16, 'aria-hidden': 'true' })
            </a>
          </div>
        </div>
      </section>

      <section class="landing-code-section landing-container" aria-labelledby="code-title">
        <div>
          <span class="landing-eyebrow">Less plumbing. More shipping.</span>
          <h2 id="code-title">Good things come<br>in small APIs.</h2>
          <p>Configure your channels. Give your notification a message for each one. Then let Facteur handle the delivery.</p>
          <a class="landing-text-link" href="/docs/notifications">
            Meet the notification API
            @svg('tabler:arrow-right', { width: 18, height: 18, 'aria-hidden': 'true' })
          </a>
          <div class="landing-code-note">
            @svg('tabler:brand-typescript', { width: 21, height: 21, 'aria-hidden': 'true' })
            TypeScript all the way down.
          </div>
        </div>
        <div class="landing-code-window">
          <div class="landing-code-toolbar"><span><i></i><i></i><i></i></span><span>send_notification.ts</span><span>TS</span></div>
          <div class="landing-code-example markdown">
            @!component('dimer_contents', { nodes: file.ast.children, pipeline })~
          </div>
          <div class="landing-code-footer"><span class="landing-delivery-dot"></span> Your channels. Your recipients. One send.</div>
        </div>
      </section>

      <section class="landing-features landing-container" aria-label="Built for real applications">
        @each(feature in [
          { number: '01', icon: 'tabler:adjustments-horizontal', title: 'Their notifications. Their rules.', description: 'Channel preferences and tenant context, so each message belongs in the right place.', href: '/docs/preferences', link: 'User preferences' },
          { number: '02', icon: 'tabler:inbox', title: 'Make yourself at home.', description: 'Database history, read status, a server API and React hooks for your in-app notification center.', href: '/docs/in-app-notifications', link: 'Build an inbox' },
          { number: '03', icon: 'tabler:code', title: 'Fits your code. Not the reverse.', description: 'Framework-agnostic at the core. Custom channels, lifecycle hooks and a built-in fake for tests.', href: '/docs/custom-channels', link: 'Make it your own' }
        ])
          <article>
            <div class="landing-feature-top">
              @svg(feature.icon, { width: 27, height: 27, 'aria-hidden': 'true' })
              <span>{{ feature.number }}</span>
            </div>
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.description }}</p>
            <a class="landing-text-link" href="{{ feature.href }}">
              {{ feature.link }}
              @svg('tabler:arrow-up-right', { width: 17, height: 17, 'aria-hidden': 'true' })
            </a>
          </article>
        @end
      </section>

      <section id="channels" class="landing-channels landing-container" aria-labelledby="channels-title">
        <div class="landing-section-heading">
          <div><span class="landing-eyebrow">Same message. Different addresses.</span><h2 id="channels-title">Pick your destinations.</h2></div>
          <p>Install only the providers you need.<br>Bring your own when you need more.</p>
        </div>
        <div class="landing-provider-grid">
          @each(category in providers.categories)
            <div class="landing-provider-group">
              <h3>{{ category.title === 'Misc' ? 'Webhooks' : category.title }}</h3>
              @each(provider in category.providers)
                <a href="{{ provider.docLink }}">
                  @svg(provider.icon, { width: 19, height: 19, 'aria-hidden': 'true' })
                  <span>{{ provider.name }}</span>
                  @svg('tabler:arrow-up-right', { width: 15, height: 15, 'aria-hidden': 'true' })
                </a>
              @end
            </div>
          @end
        </div>
      </section>

      <section class="landing-integrations landing-container" aria-label="Framework integrations">
        <span>At home in your stack.</span>
        <a href="/docs/adonisjs">
          @svg('brand:adonisjs', { width: 23, height: 23, 'aria-hidden': 'true' })
          AdonisJS
        </a>
        <a href="/docs/hono">
          @svg('brand:hono', { width: 20, height: 24, 'aria-hidden': 'true' })
          Hono
        </a>
        <a href="/docs/facteurjs-react">
          @svg('tabler:brand-react', { width: 24, height: 24, 'aria-hidden': 'true' })
          React
        </a>
        <span class="landing-integrations-note">Or just plain Node.js. You choose.</span>
      </section>

      <section class="landing-final landing-container" aria-labelledby="final-title">
        <div><span class="landing-eyebrow">Ready for your first delivery?</span><h2 id="final-title">Let’s send something good.</h2></div>
        <a class="landing-button" href="/docs/quick-start">
          Open the quick start
          @svg('tabler:arrow-right', { width: 19, height: 19, 'aria-hidden': 'true' })
        </a>
      </section>
    </main>

    <footer class="landing-footer landing-container">
      <a class="landing-brand" href="/">
        @include('partials/logo')
        <span>facteur.</span>
      </a>
      <span>Made by <a href="https://github.com/Julien-R44">Julien Ripouteau</a>. Open source, always.</span>
      <a href="https://github.com/sponsors/Julien-R44">
        Support the project
        @svg('tabler:heart', { width: 16, height: 16, 'aria-hidden': 'true' })
      </a>
    </footer>
  </div>
@end
